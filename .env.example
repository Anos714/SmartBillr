# ── SmartBillr env ──
# Copy to .env.local and fill real values. User provides ALL credentials.
# Marketing + guest mode work even if optional keys are empty.

# Required for DB-backed features (auth, saved invoices)
DATABASE_URL="postgresql://user:password@host:5432/smartbillr"

# Auth (Better Auth + Google OAuth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (logos, signatures, avatars — DB stores only secure_url + publicId)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="smartbillr_assets"

# Dodo Payments (Pro checkout + webhook)
DODO_PAYMENTS_API_KEY=""
DODO_WEBHOOK_SECRET=""
NEXT_PUBLIC_DODO_PRO_PRODUCT_ID=""
# Optional: recurring ₹199/mo product. When empty, the pricing page shows
# Monthly as "Soon" and the API rejects billing:"monthly" (no fake checkout).
NEXT_PUBLIC_DODO_MONTHLY_PRODUCT_ID=""
DODO_RETURN_URL="http://localhost:3000/pricing?success=true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
